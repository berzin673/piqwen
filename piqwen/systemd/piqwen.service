[Unit]
Description=PiQwen AI Server
Documentation=https://github.com/yourusername/piqwen
After=network-online.target hostapd.service dnsmasq.service
Wants=network-online.target hostapd.service dnsmasq.service
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=simple
User=piqwen
Group=piqwen
WorkingDirectory=/home/piqwen/piqwen/server
ExecStart=/home/piqwen/piqwen/scripts/start.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/piqwen/piqwen/server
Environment=OMP_NUM_THREADS=3
Environment=OPENBLAS_NUM_THREADS=3
Environment=MKL_NUM_THREADS=3

# Resource limits for 4GB RAM
MemoryLimit=3G
MemorySwapMax=512M
CPUQuota=300%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/piqwen/piqwen /var/log/piqwen
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piqwen

[Install]
WantedBy=multi-user.target